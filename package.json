{
    "name": "@hapi/oxc-plugin",
    "version": "1.0.0",
    "description": "ESLint plugin containing hapi style guide rules and config",
    "keywords": [
        "oxlint",
        "oxfmt",
        "hapi",
        "lint"
    ],
    "license": "BSD-3-Clause",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hapijs/oxc-plugin.git"
    },
    "files": [
        "src"
    ],
    "type": "module",
    "main": "src/index.js",
    "exports": {
