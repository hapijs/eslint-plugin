    "devDependencies": {
        "@hapi/oxc-plugin": "file:.",
        "@vitest/coverage-v8": "^4.1.2",
        "oxfmt": "^0.42.0",
        "oxlint": "^1.57.0",
        "vitest": "^4.1.2"
    },
    "engines": {
        "node": ">=22"
    }
